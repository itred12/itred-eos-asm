
def 0 {
    back2_SetMode(4);
    screen_FadeOut(1, 0);
    screen2_FadeOut(1, 0);
    camera_SetMyself<performer 0>();
    Slide2Position<performer 0>(30, 128, 96);
    back2_SetGround(LEVEL_S02P01A);
    back_SetGround(LEVEL_S02P01A);
    message_Explanation('[CN][W:180]. [W:40]. [W:40].[C]');
    message_Explanation('''
        [CN]Ah. [W:60]Finally,[W:30] another presence. [K]
        [CN]I had nearly[W:20] given up on waiting.
    ''');
    
    switch (ProcessSpecial(PROCESS_SPECIAL_INIT_MAIN_TEAM_AFTER_QUIZ, 0, 0)) {}
   
    message_Explanation('''
        Hero: [pr_hero:subj], [pr_hero:obj], [pr_hero:pos], [pr_hero:pos_plr]
        Partner: [pr_partner:subj], [pr_partner:obj], [pr_partner:pos], [pr_partner:pos_plr]
    ''');
    
    
    message_Explanation('''
        [CN]Forgive me,[W:30] but we will have to 
        [CN]make this[W:20] somewhat brief.[C]
    ''');
    bgm2_PlayFadeIn(BGM_EARTHQUAKE2, 0, 256);
    camera_SetEffect(2, 1, 1.0);
    Wait(45);
    message_Explanation('[CN]We are.[W:10].[W:10].[W:30] Behind schedule.[C]');
    bgm2_FadeOut(360);
    switch ( random(2) ) {
        case 0:
            @label_0;
            message_Explanation('''
                [CN]Know that [W:20]this is not your fault.[K]
                [CN]Please do not cry.
            ''');
            camera_SetEffect(0, 0, 0);
            message_Explanation('''
                [CN]These are cirumstances[W:30]
                [CN]Which were thrown out of your control.
            ''');
            message_Explanation('''
                [CN]There is no blame to cast.[K]
                [CN]We can only adapt[W:30] to what time 
                [CN]we've been given.
            ''');
            @label_2;
            message_Explanation('[CN]Now,[W:30] this in mind[W:20].[W:20].[W:20].');
            bgm_PlayFadeIn(BGM_WELCOME_TO_THE_WORLD_OF_POKEMON, 60, 255);
            screen_FadeOutAll(1, 0);
            screen2_FadeIn(0, 120);
            screen_FadeIn(0, 0);
            screen_FadeInAll(1, 120);
            message_Monologue('Let us hasten.');
            message_Close();
            message_Monologue('''
                First,[W:30] the matter of a body.[K]
                You will need a means[W:30] of experiencing
                and interacting with this world.
            ''');
            message_Close();
            bgm2_PlayFadeIn(BGM_EARTHQUAKE2, 0, 256);
            camera_SetEffect(2, 1, 1.0);
            Wait(45);
            message_Monologue('''
                Typically,[W:30] there are formalities 
                and traditions that follow in this.
            ''');
            message_Close();
            bgm2_FadeOut(360);
            message_Monologue('''
                Especially for something[W:30] so
                immeasurably important[W:30] to those
                whom we harbor.
            ''');
            message_Close();
            camera_SetEffect(0, 0, 0);
            switch ( random(2) ) {
                case 0:
                    message_Monologue('But,[W:30] given the circumstances.[W:30].[W:30].[W:30]');
                    @label_5;
                    message_Close();
                    message_Monologue('''
                        We will have to make do[W:20] with skipping
                        straight to the end.[W:60]
                    ''');
                    screen2_FadeOut(1, 30);
                    screen_FadeOut(1, 30);
                    screen2_FadeInAll(1, 0);
                    end;
                default:
                    @label_4;
                    message_Monologue('''
                        However,[W:30] we simply do not have[W:20]
                        the luxury of time.
                    ''');
                    jump @label_5;
            }
            break;
        default:
            @label_1;
            message_Explanation('''
                [CN]Please[W:20] do not cry.[K]
                [CN]So long as we do not dawdle,[W:30]
                [CN]we will be safe.
            ''');
            camera_SetEffect(0, 0, 0);
            message_Explanation('''
                [CN]We can still make do[W:20]
                [CN]with the time[W:20] we've been given.[C]
            ''');
            jump @label_2;
    }
}
